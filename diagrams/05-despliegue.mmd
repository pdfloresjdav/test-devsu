C4Deployment
  title Diagrama de Despliegue - Infraestructura AWS (BP Banca Digital)

  Deployment_Node(cliente, "Dispositivo del cliente", "Navegador / iOS / Android"){
    Container(spa, "SPA", "React + TypeScript")
    Container(mobile, "App movil", "React Native + TypeScript")
  }

  Deployment_Node(edge, "Edge Global", "CloudFront + Route 53 + WAF"){
    Container(waf, "WAF + CloudFront + Route 53", "Perimetro, TLS y failover multi-region")
  }

  Deployment_Node(regionPrimary, "Region Primaria (ej. us-east-1) - Activa", "AWS Region"){
    Container(apigw, "API Gateway", "Autorizacion JWT, throttling")

    Deployment_Node(compute, "ECS Fargate - Multi-AZ", "2+ tareas por zona"){
      Container(bff, "BFF Web / Movil", "Laravel Octane")
      Container(svc, "Datos, Movimientos, Transferencias", "Laravel Octane")
      Container(worker, "Workers Auditoria/Notif.", "Laravel Horizon")
    }

    ContainerDb(aurora, "Aurora MySQL", "Multi-AZ")
    ContainerDb(redis, "ElastiCache Redis", "Multi-AZ")

    Deployment_Node(regionalSvcs, "Servicios administrados regionales", "Multi-AZ nativo"){
      Container(bus, "EventBridge + SQS", "Bus de eventos con DLQ")
      ContainerDb(dynamo, "DynamoDB", "On-demand")
      ContainerDb(s3worm, "S3 Object Lock", "WORM")
      Container(pinpointSes, "Pinpoint + SES", "Notificaciones")
    }
  }

  Deployment_Node(regionDR, "Region DR (ej. us-west-2) - Pasiva", "AWS Region"){
    ContainerDb(auroraDR, "Aurora MySQL Global DB", "Replica promovible")
    ContainerDb(dynDR, "DynamoDB Global Tables", "Replica multi-region")
    ContainerDb(s3DR, "S3 CRR", "Copia de objetos WORM")
  }

  Rel(spa, waf, "HTTPS/TLS 1.2+")
  Rel(mobile, waf, "HTTPS/TLS 1.2+")
  Rel(waf, apigw, "HTTPS")
  Rel(apigw, bff, "HTTPS interno + mTLS")
  Rel(bff, svc, "REST interno")
  Rel(svc, aurora, "SQL/TLS")
  Rel(svc, bus, "Publica eventos")
  Rel(worker, bus, "Consume eventos")
  Rel(aurora, auroraDR, "Global Database (RPO ~1s)")
  Rel(dynamo, dynDR, "Global Tables")
  Rel(s3worm, s3DR, "Cross-Region Replication")
