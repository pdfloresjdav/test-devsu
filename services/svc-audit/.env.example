APP_NAME=svc-audit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- bp-common: authentication (no HTTP auth applies in this service, but
# bp-common.jwt is still resolved in case something requires it) ---
OAUTH_MODE=local
OIDC_ISSUER=http://localhost:4011
OIDC_AUDIENCE=bp-web
DPOP_ENFORCED=false
# Optional: URL by which THIS process reaches the OIDC issuer for
# discovery/JWKS, when it differs from OIDC_ISSUER (e.g. inside
# docker-compose: OIDC_ISSUER stays the one seen by the browser,
# OIDC_DISCOVERY_ISSUER points at the service name on the internal network).
# Empty = the same value as OIDC_ISSUER is used (default outside docker-compose).
OIDC_DISCOVERY_ISSUER=

# --- bp-common: AWS (DynamoDB, EventBridge, SQS). Empty AWS_ENDPOINT_URL = real AWS ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EVENT_BUS_NAME=bp-domain-events
EVENT_SOURCE=bp.svc-audit

# --- Audit service ---
AUDIT_TABLE=audit
AUDIT_BUCKET=bp-audit-worm
AUDIT_QUEUE_NAME=audit-events-queue
AUDIT_DLQ_NAME=audit-events-dlq
AUDIT_RULE_NAME=audit-all-domain-events
AUDIT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/audit-events-queue
