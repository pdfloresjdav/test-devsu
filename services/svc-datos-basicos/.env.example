APP_NAME=svc-datos-basicos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=roadrunner

# --- bp-common: autenticacion (ver packages/bp-common) ---
OAUTH_MODE=local
OIDC_ISSUER=http://localhost:4011
OIDC_AUDIENCE=bp-web
DPOP_ENFORCED=false
# Opcional: URL por la que ESTE proceso alcanza al emisor OIDC para el
# discovery/JWKS, cuando difiere de OIDC_ISSUER (ej. dentro de
# docker-compose: OIDC_ISSUER sigue siendo el que ve el navegador,
# OIDC_DISCOVERY_ISSUER apunta al nombre del servicio en la red interna).
# Vacio = se usa el mismo valor que OIDC_ISSUER (default fuera de docker-compose).
OIDC_DISCOVERY_ISSUER=

# --- Clientes de datos del cliente (patron API Composition, decision 3.11) ---
# 'fake' mientras el sistema real no exista; 'http' para apuntar al real.
CORE_BANCARIO_DRIVER=fake
CORE_BANCARIO_BASE_URL=
CLIENTE_COMPLEMENTARIO_DRIVER=fake
CLIENTE_COMPLEMENTARIO_BASE_URL=
