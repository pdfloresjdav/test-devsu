# Variables compartidas por el entorno local (docker-compose.yml).
# Copiar a .env y ajustar si hace falta. El .env real nunca se commitea.

# --- MySQL (Aurora MySQL-compatible en local) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bp
MYSQL_PORT=3306

# --- Redis (ElastiCache-compatible en local) ---
REDIS_PORT=6379

# --- LocalStack (emula DynamoDB, SQS, EventBridge, S3) ---
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
# Credenciales dummy que exige el AWS SDK aunque LocalStack no las valide
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Mock OIDC (stand-in local de Auth0 / Okta CIC) ---
MOCK_OIDC_PORT=4011
# En cada servicio: OAUTH_MODE=local usa este emisor; OAUTH_MODE=auth0 usa AUTH0_DOMAIN real
OAUTH_MODE=local
OIDC_ISSUER=http://localhost:4011
OIDC_CLIENT_ID=bp-web

# --- Cuando se conecte AWS real (produccion) ---
# OAUTH_MODE=auth0
# AUTH0_DOMAIN=bp.us.auth0.com
# AUTH0_AUDIENCE=https://api.bp.com
# AWS_ACCESS_KEY_ID=<via IAM Task Role, no hardcodear>
# AWS_SECRET_ACCESS_KEY=<via IAM Task Role, no hardcodear>
