# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp

# Node (si se usa mermaid-cli u otras herramientas locales de renderizado)
node_modules/
npm-debug.log*
# Excepcion: la convencion de empaquetado de AWS Synthetics (modulo
# infra/terraform/modules/observability) exige que el script del canario
# viva literalmente en una carpeta "nodejs/node_modules/" -- no son
# dependencias instaladas, es el codigo fuente real del canario.
!infra/terraform/modules/observability/canary/nodejs/node_modules/
!infra/terraform/modules/observability/canary/nodejs/node_modules/*.js

# PHP / Composer
vendor/
.phpunit.result.cache
# packages/* son librerias (no apps): no se commitea su lock, cada consumidor resuelve el suyo.
# Los servicios en services/* SI deben commitear su composer.lock (son aplicaciones).
packages/*/composer.lock

# Salidas de exportación generadas localmente
*.pdf
*.png
*.svg
!docs/*.pdf
!diagrams/**/*.png
!diagrams/**/*.svg
# Assets estaticos reales de los frontends (favicon, iconos propios) — no son
# exportaciones generadas, se necesitan en un clone limpio.
!frontend-web/public/**/*.svg
!frontend-web/src/**/*.svg
!frontend-mobile/**/*.svg
!frontend-mobile/**/*.png

# Variables de entorno reales (nunca commitear, solo .env.example)
.env
.env.local
services/*/.env
frontend-web/.env
frontend-mobile/.env

# Terraform (infra/terraform) -- el backend de estado real (S3) todavia no
# esta provisionado (ver infra/terraform/README.md), asi que el estado local
# de cualquier prueba de fmt/init/validate/plan en este entorno no se commitea.
# El lock de providers (.terraform.lock.hcl) SI se commitea (garantiza las
# mismas versiones de provider en cualquier maquina/CI).
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfplan
infra/terraform/**/*.auto.tfvars
infra/terraform/**/terraform.tfvars

# Archivos temporales
*.tmp
*.log
