# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp

# Node (si se usa mermaid-cli u otras herramientas locales de renderizado)
node_modules/
npm-debug.log*

# PHP / Composer
vendor/
.phpunit.result.cache
# packages/* son librerias (no apps): no se commitea su lock, cada consumidor resuelve el suyo.
# Los servicios en services/* SI deben commitear su composer.lock (son aplicaciones).
packages/*/composer.lock

# Salidas de exportación generadas localmente
*.pdf
*.png
*.svg
!docs/*.pdf
!diagrams/**/*.png
!diagrams/**/*.svg
# Assets estaticos reales de los frontends (favicon, iconos propios) — no son
# exportaciones generadas, se necesitan en un clone limpio.
!frontend-web/public/**/*.svg
!frontend-web/src/**/*.svg
!frontend-mobile/**/*.svg
!frontend-mobile/**/*.png

# Variables de entorno reales (nunca commitear, solo .env.example)
.env
.env.local
services/*/.env
frontend-web/.env
frontend-mobile/.env

# Archivos temporales
*.tmp
*.log
