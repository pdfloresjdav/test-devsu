{
    "name": "bp/common",
    "description": "Componentes compartidos entre los microservicios de BP: validacion JWT/DPoP, correlation-id, envelope de respuesta y healthcheck.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.389",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "BP\\Common\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BP\\Common\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BP\\Common\\BpCommonServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
