# OIDC issuer (Authorization Code + PKCE). Locally, mock-oidc exposed by
# docker-compose (port MOCK_OIDC_PORT, default 4011); in a real
# environment, the Auth0/Okta CIC domain. Expo inlines at build time any
# variable with the EXPO_PUBLIC_ prefix (equivalent to frontend-web's VITE_).
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:4011

# Client ID registered in the OIDC issuer. Locally it must be "bp-web": the
# same public client configured in mock-oidc's CLIENTS_CONFIGURATION_INLINE
# (docker-compose.yml), which already reserves the redirect_uri
# http://localhost:19006/callback for this app (see CLAUDE.md).
EXPO_PUBLIC_OIDC_CLIENT_ID=bp-web

# Base URL of the BFF Mobile (services/bff-mobile).
EXPO_PUBLIC_BFF_MOBILE_URL=http://localhost:8004

# Account used to pre-fill the movement query form in local demos.
EXPO_PUBLIC_DEMO_ACCOUNT_ID=1001
