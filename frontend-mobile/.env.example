# Emisor OIDC (Authorization Code + PKCE). En local, mock-oidc expuesto por
# docker-compose (puerto MOCK_OIDC_PORT, default 4011); en un ambiente real,
# el dominio de Auth0/Okta CIC. Expo inlinea en build cualquier variable con
# el prefijo EXPO_PUBLIC_ (equivalente al VITE_ de frontend-web).
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:4011

# Client ID registrado en el emisor OIDC. En local debe ser "bp-web": el
# mismo cliente publico configurado en CLIENTS_CONFIGURATION_INLINE de
# mock-oidc (docker-compose.yml), que ya reserva el redirect_uri
# http://localhost:19006/callback para esta app (ver CLAUDE.md).
EXPO_PUBLIC_OIDC_CLIENT_ID=bp-web

# URL base del BFF Móvil (services/bff-mobile).
EXPO_PUBLIC_BFF_MOBILE_URL=http://localhost:8004

# Cuenta usada para precargar el formulario de consulta de movimientos en demos locales.
EXPO_PUBLIC_DEMO_CUENTA_ID=1001
