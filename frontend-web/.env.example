# OIDC issuer (Authorization Code + PKCE). Locally, mock-oidc exposed by
# docker-compose (port MOCK_OIDC_PORT, default 4011); in a real
# environment, the Auth0/Okta CIC domain.
VITE_OIDC_ISSUER=http://localhost:4011

# Client ID registered in the OIDC issuer for this SPA (public client, no
# secret, Authorization Code + PKCE). Locally it must be "bp-web": it's the
# ClientId already configured in mock-oidc's CLIENTS_CONFIGURATION_INLINE
# (docker-compose.yml), with redirect_uri http://localhost:5173/callback.
VITE_OIDC_CLIENT_ID=bp-web

# Base URL of the BFF Web (services/bff-web).
VITE_BFF_WEB_URL=http://localhost:8010

# Account used to pre-fill the movement query form in local demos.
VITE_DEMO_ACCOUNT_ID=1001
