# Emisor OIDC (Authorization Code + PKCE). En local, mock-oidc expuesto por
# docker-compose (puerto MOCK_OIDC_PORT, default 4011); en un ambiente real,
# el dominio de Auth0/Okta CIC.
VITE_OIDC_ISSUER=http://localhost:4011

# Client ID registrado en el emisor OIDC para esta SPA (public client, sin
# secret, Authorization Code + PKCE). En local debe ser "bp-web": es el
# ClientId ya configurado en CLIENTS_CONFIGURATION_INLINE de mock-oidc
# (docker-compose.yml), con redirect_uri http://localhost:5173/callback.
VITE_OIDC_CLIENT_ID=bp-web

# URL base del BFF Web (services/bff-web).
VITE_BFF_WEB_URL=http://localhost:8010

# Cuenta usada para precargar el formulario de consulta de movimientos en demos locales.
VITE_DEMO_CUENTA_ID=1001
